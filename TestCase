private void validateSiteDetails(String siteDetails) {
    if (StringUtils.isBlank(siteDetails)) {
        return;
    }

    String[] urls = siteDetails.split(",", -1);

    for (String url : urls) {
        if (!url.equals(url.trim())) {
            errorDtoList.add(
                ErrorDto.builder()
                    .errorCode("8010")
                    .errorMessage(
                        VSCC_INFO + SITE_DETAILS
                            + " contains leading or trailing spaces. "
                            + "Please provide a valid value."
                    )
                    .build()
            );
            return;
        }

        if (url.isEmpty() || validate(url, WEBSITE_URL_REGEX)) {
            errorDtoList.add(
                ErrorDto.builder()
                    .errorCode("8002")
                    .errorMessage(
                        VSCC_INFO + SITE_DETAILS
                            + " is invalid. Reason : Format is incorrect"
                    )
                    .build()
            );
            return;
        }
    }
}